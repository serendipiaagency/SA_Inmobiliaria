{
  "name": "mm-real-estate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "preview:staging": "wrangler dev --env staging",
    "deploy": "nuxt build && wrangler deploy --env=\"\"",
    "deploy:staging": "nuxt build && wrangler deploy --env staging",
    "db:migrate:local": "wrangler d1 migrations apply sa_inmobiliaria --local",
    "db:migrate": "wrangler d1 migrations apply sa_inmobiliaria --remote",
    "db:migrate:staging": "wrangler d1 migrations apply sa_inmobiliaria_staging --remote --env staging",
    "db:pending": "wrangler d1 migrations list sa_inmobiliaria --remote --env=\"\"",
    "db:pending:staging": "wrangler d1 migrations list sa_inmobiliaria_staging --remote --env staging",
    "migrations:check": "node scripts/check-migrations.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "typecheck": "nuxi typecheck",
    "test": "vitest run",
    "test:e2e": "bash scripts/e2e.sh",
    "release": "wrangler d1 migrations apply sa_inmobiliaria --remote --env=\"\" && nuxt build && wrangler deploy --env=\"\"",
    "release:staging": "wrangler d1 migrations apply sa_inmobiliaria_staging --remote --env staging && nuxt build && wrangler deploy --env staging",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/qrcode": "^1.5.6",
    "commander": "^13.1.0",
    "nitro-cloudflare-dev": "^0.2.2",
    "nuxt": "^3.17.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.20.0"
  }
}
